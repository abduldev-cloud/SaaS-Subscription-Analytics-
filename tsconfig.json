{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  },
  "include": ["src"]
}